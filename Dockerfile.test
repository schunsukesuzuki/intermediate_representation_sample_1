# Separate test image avoids installing pytest in the running API image.
FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    JAX_PLATFORMS=cpu \
    XLA_PYTHON_CLIENT_PREALLOCATE=false
RUN apt-get update && apt-get install -y --no-install-recommends fonts-ipafont-gothic \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md LICENSE-NOTE.md ./
COPY src ./src
RUN python -m pip install --upgrade pip && python -m pip install '.[test,api]'
COPY scripts ./scripts
COPY tests ./tests
CMD ["python", "-m", "pytest", "-q", "tests"]
